  "teaching_method": {
    "note": "MOS 标准歌曲教学十步法。它不是十段视频，而是一条从上到下的顺序：先知道唱什么，再让身体准备好，再分别处理谱、节奏、视唱、词，最后合成、示唱、自主歌唱，并迁移到独立视唱与教别人。三个模式（学唱 / 视唱 / 教唱）是同一首歌的三种使用方式，不是三套流程。",
    "steps": [
      {
        "key": "know_song",
        "no": "01",
        "label": "认识歌曲",
        "goal": "先知道我要唱什么。",
        "modes": [
          "learn",
          "sight",
          "teach"
        ],
        "not_sight_training": true
      },
      {
        "key": "warm_body",
        "no": "02",
        "label": "准备声音与身体",
        "goal": "让身体准备好唱，不做专业声乐训练。",
        "modes": [
          "learn",
          "teach"
        ]
      },
      {
        "key": "teach_score",
        "no": "03",
        "label": "教谱",
        "goal": "普通人也能看懂这首歌的谱。",
        "modes": [
          "sight",
          "teach"
        ]
      },
      {
        "key": "teach_rhythm",
        "no": "04",
        "label": "教节奏",
        "goal": "身体先认识节拍。",
        "modes": [
          "sight",
          "teach"
        ]
      },
      {
        "key": "sight_singing",
        "no": "05",
        "label": "视唱训练",
        "goal": "看谱 → 内听 → 唱，此时暂时关闭示范。",
        "modes": [
          "sight"
        ]
      },
      {
        "key": "teach_words",
        "no": "06",
        "label": "教词",
        "goal": "先把词说顺，再把词唱进去。",
        "modes": [
          "learn",
          "teach"
        ]
      },
      {
        "key": "combine",
        "no": "07",
        "label": "词曲合成",
        "goal": "音高 + 节奏 + 歌词合在一起。",
        "modes": [
          "learn",
          "teach"
        ]
      },
      {
        "key": "live_demo",
        "no": "08",
        "label": "真人示唱",
        "goal": "示范正确的声音与音乐表达。",
        "modes": [
          "learn",
          "teach"
        ]
      },
      {
        "key": "sing_alone",
        "no": "09",
        "label": "自主歌唱",
        "goal": "关掉示唱，只剩伴奏，自己唱。",
        "modes": [
          "learn"
        ]
      },
      {
        "key": "independent",
        "no": "10",
        "label": "独立视唱 + 教别人",
        "goal": "只给简谱与起音，自己唱；并向别人示范怎么看谱、怎么打拍、哪里换气。",
        "modes": [
          "learn",
          "sight",
          "teach"
        ]
      }
    ],
    "modes": [
      {
        "key": "learn",
        "label": "学唱",
        "note": "适合第一次学一首歌：听 → 跟 → 陪 → 自己唱。可以使用男声 / 女声 / 钢琴 / 慢速 / 分句 / 循环。",
        "gives_full_demo_first": true,
        "sequence": [
          {
            "key": "listen",
            "label": "听",
            "hint": "先听一遍，找到调子，不急着跟。"
          },
          {
            "key": "repeat",
            "label": "跟",
            "hint": "跟着示唱一句一句跟，唱不准就重来。"
          },
          {
            "key": "accompany",
            "label": "陪",
            "hint": "开钢琴陪唱，和伴奏一起唱。"
          },
          {
            "key": "self",
            "label": "自己唱",
            "hint": "关掉人声，只听钢琴，自己唱一遍。"
          },
          {
            "key": "again",
            "label": "再唱一次",
            "hint": "今天多唱一次就够了；过几天再回来唱。"
          }
        ]
      },
      {
        "key": "sight",
        "label": "视唱",
        "note": "适合训练音乐能力：看谱 → 内听 → 唱 → 核对 → 修正。默认不先给完整示唱，只给起音、节拍与钢琴参考，最后才播放示唱核对。",
        "gives_full_demo_first": false,
        "sequence": [
          {
            "key": "read",
            "label": "看谱",
            "hint": "先看调、拍号、起音与结构。"
          },
          {
            "key": "inner_hear",
            "label": "内听",
            "hint": "看着谱在心里听见它，先不出声。"
          },
          {
            "key": "sing",
            "label": "视唱",
            "hint": "看谱唱出来；可以只听起音与节拍。"
          },
          {
            "key": "check",
            "label": "核对",
            "hint": "现在才播放示唱，对照自己唱的对不对。"
          },
          {
            "key": "fix",
            "label": "修正",
            "hint": "把不稳的一句单独再练一次。"
          }
        ]
      },
      {
        "key": "teach",
        "label": "教唱",
        "note": "适合父母 / 小组长 / 主日学教师 / 敬拜同工 / 普通信徒。教唱是把这首歌交给另一个人，不是讲解乐理。",
        "gives_full_demo_first": true,
        "sequence": [
          {
            "key": "teach_score",
            "label": "教谱",
            "hint": "告诉他这一句怎么看、第一音在哪里。"
          },
          {
            "key": "teach_rhythm",
            "label": "教节奏",
            "hint": "一起拍手打拍，先把节拍走顺。"
          },
          {
            "key": "teach_words",
            "label": "教词",
            "hint": "先读词、再说词，指出容易唱错的字。"
          },
          {
            "key": "demonstrate",
            "label": "示范",
            "hint": "你唱一句给他听，不要唱整首。"
          },
          {
            "key": "follow",
            "label": "跟唱",
            "hint": "他唱一句，你跟一句，唱不准就再示范。"
          },
          {
            "key": "accompany",
            "label": "伴奏陪唱",
            "hint": "开伴奏，让他自己唱，你在旁边看换气。"
          },
          {
            "key": "full",
            "label": "全曲",
            "hint": "最后完整唱一遍，唱完给他一点鼓励。"
          }
        ]
      }
    ]
  },
