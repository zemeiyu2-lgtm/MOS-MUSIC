  "content_understanding": {
    "what_it_sings": {
      "text": "这首歌以“恩典”为主线：从曾经失丧、盲目，到被寻回、重新看见；随后把这份恩典延伸到一生的患难、盼望与最终的赞美。",
      "derived_from": "content/songs/MUS-S-0001.json#formation.emotion + content/songs/MUS-S-0001.json#formation.memory"
    },
    "core_truth": {
      "text": "救恩的根基在神的恩典，而不是人的功劳；蒙恩之后，人以感恩、信靠与继续跟随回应这份恩典。",
      "derived_from": "content/songs/MUS-S-0001.json#theology.soteriology"
    },
    "bible_basis": [
      {
        "reference": "弗2:1–10",
        "derived_from": "content/songs/MUS-S-0001.json#bible.core_passage"
      }
    ],
    "background": {
      "text": null,
      "derived_from": null
    },
    "why_church_sings": {
      "text": "教会唱这首歌，不只是纪念个人经历，也是在共同宣告恩典、救恩与被寻回的盼望；它可以自然用于福音、感恩、见证与安慰的场景。",
      "derived_from": "content/songs/MUS-S-0001.json#bible.bible_themes + content/songs/MUS-S-0001.json#formation.primary_function"
    },
    "note": "以上文字均从歌曲详情层已有主题、情感与神学字段整理，不绑定周次或课程。",
    "status": "PROVIDED"
  },
