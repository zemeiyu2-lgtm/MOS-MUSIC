  "teacher_script": {
    "method_ref": "docs/standards/MOS-SONG-TEACHING-METHOD-V1.0.md（十步法框架）+ 用户文档《五首样板歌曲教师教学脚本与制作包 V1.0》",
    "core_principle": "这首歌最先学的不是「兴奋」，而是拍子。高潮不是抢拍，也不是喊大声：把音准和节奏守住，音乐自然会起来。",
    "teacher_guidance": [
      "重复不是随便唱：第二遍要和第一遍一样稳，然后才有群体的力量。",
      "密集歌词：先说词 → 拍节奏 → 简谱 → 加词。",
      "领唱要求：起拍清楚、不抢速度、不过度装饰、第一遍给空间、后面逐渐增加群体音量。"
    ],
    "steps": [
      {
        "key": "step-01",
        "label": "认识歌曲",
        "teacher_says": "先不要急着唱。第一遍只听：旋律往哪里走？哪一句最容易记住？哪一句最难？",
        "tasks": [
          "只听",
          "感受拍号与速度",
          "找到重复句",
          "不要求记忆歌词"
        ]
      },
      {
        "key": "step-02",
        "label": "准备身体与声音",
        "teacher_says": "我们先把声音放松，不追求大声。先找到稳定、自然的声音。",
        "tasks": [
          "深吸气，不耸肩",
          "轻声哼唱起音",
          "元音延长",
          "避免用喉咙硬推高音"
        ]
      },
      {
        "key": "step-03",
        "label": "教简谱",
        "teacher_says": "先不要背每一个音。先看这一句是在上行、下行，还是停留。",
        "tasks": [
          "先看调号",
          "找主音",
          "看乐句轮廓",
          "看长音、休止、重复音",
          "再进入逐小节"
        ]
      },
      {
        "key": "step-04",
        "label": "教节奏",
        "teacher_says": "先拍节奏，再唱音高。",
        "tasks": [
          "手拍拍号",
          "口读节奏",
          "钢琴只给节拍",
          "加入旋律"
        ]
      },
      {
        "key": "step-05",
        "label": "视唱",
        "teacher_says": "主音 → 起音 → 第一乐句 → 两句连接 → 整节；教师不连续示唱全部。",
        "tasks": [
          "反馈句式：这一句第二个音稍低，再唱一次。",
          "节奏对了，现在保持住音高。",
          "这一句先不要快，把长音唱稳。"
        ]
      },
      {
        "key": "step-06",
        "label": "教歌词",
        "teacher_says": "歌词教学独立于音符教学。",
        "tasks": [
          "说词",
          "找关键词",
          "找重音",
          "处理辅音",
          "再与旋律结合"
        ]
      },
      {
        "key": "step-07",
        "label": "词曲合成",
        "teacher_says": "少示范，多模仿；短句循环，逐步撤掉示范。",
        "tasks": [
          "一句听",
          "一句跟",
          "一句独唱",
          "两句连接",
          "一节完整"
        ]
      },
      {
        "key": "step-08",
        "label": "真人示唱",
        "teacher_says": "播放优秀真人版本，观察表达，不要求模仿歌手个人音色。",
        "tasks": [
          "呼吸在哪里",
          "哪个词更突出",
          "哪里收声",
          "哪里渐强",
          "哪里保持克制"
        ]
      },
      {
        "key": "step-09",
        "label": "自主歌唱",
        "teacher_says": "伴奏由强到弱，目标是逐渐脱离模仿。",
        "tasks": [
          "完整伴奏",
          "简化钢琴",
          "仅起音",
          "无示唱"
        ]
      },
      {
        "key": "step-10",
        "label": "独立视唱＋教别人",
        "teacher_says": "请你不听示唱，只看谱唱一遍；然后把最难的一句教给另一个人。",
        "tasks": [
          "会唱不是终点",
          "会带别人唱才进入可传递状态"
        ]
      }
    ],
    "first_lesson_flow": [
      "第一步：只拍 强｜弱｜强｜弱",
      "第二步：口读歌词节奏",
      "第三步：钢琴伴奏＋简谱",
      "第四步：加歌词"
    ]
  },
