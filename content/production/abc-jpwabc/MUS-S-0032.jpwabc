// ************** MOS-MUSIC OpenHymnal ABC → JPW-ABC 1.0 **************\n// source = sources/openhymnal/OpenHymnal2014.06.abc\n// match = exact title match from content/production/tune-matching.json\n\n.Title\nTitle = 爱主更深（More Love to Thee）\nKeyAndMeters = {1=Ab,4/4}\nWordsByAndMusicBy = Words: Elizabeth Payson Prentis, 1856.\nMusic: 'More Love to Thee' William Howard Doane, 1870.  Setting: William Howard Doane, 1870, alt.\ncopyright: public domain.  This score is a part of the Open Hymnal Project, 2012 Revision.\nExpression = {♩=75}\n\n.Voice\n#5,- 6, #5, | 2. #2_ 4- | 4- #2 2 | #2.- 0 | #5,- 6, #5, | 2. #2_ 4- | #2- 2 7, | 2.- 0 | 5- 5 5 | 5. 4_ 4- | #2- #2 #2 | #2. 2_ 2- | 6,- 6, 6, | 2.- 0 | #2- 2 7, | 2.- 0 |\n\n.Words\nW1@1,1:\n{More} {love} {to} {Thee,} O {Christ;} {More} {love} {to} {Thee;} {Hear} {Thou} {the} {pray'r} I {make} {On} {bend} {ed} {knee;} {This} {is} {my} {ear} {nest} {plea,} {More} {love,} O {Christ,} {to} {Thee,} {More} {love} {to} {Thee;} {More} {love} {to} {Thee.} / / / /\n