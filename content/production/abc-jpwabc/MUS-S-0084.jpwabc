// ************** MOS-MUSIC OpenHymnal ABC → JPW-ABC 1.0 **************\n// source = sources/openhymnal/OpenHymnal2014.06.abc\n// match = exact title match from content/production/tune-matching.json\n\n.Title\nTitle = 耶和华是我牧者（The Lord's My Shepherd）\nKeyAndMeters = {1=D,3/2}\nWordsByAndMusicBy = Words: Psalm 23 from the Scottish Psalter, 1650 alt. by James Leith Macbeth Bain, 1915.\nMusic and Setting: 'Marosa' or 'Brother James` Air' James Leith Macbeth Bain, 1915, alt.\ncopyright: public domain.  This score is a part of the Open Hymnal Project, 2013 Revision.\nExpression = {♩=70}\n\n.Voice\n1- | 3 5 1'- 5- | 6 1' 5- 4- | 3 1 1- 7,- | 1--- 1- | 3 5 1'- 5- | 6 1' 5- 4- | 3 1 1- 7,- | 1--- 2- | 3 1 1- 2- | 3 1 1- 2- | 3 5 1'- 1'- | 1'--- 1- | 3 5 1'- 5- | 6 1' 5- 4- | 3 1 1- 7,- | 1.--- |\n\n.Words\nW1@1,1:\n{The} {Lord's} {my} {shep} {herd} {I'll} {not} {want,} {He} {makes} {me} {down} {to} {lie} {In} {pas} {tures} {green} {He} {lead} {eth} {me} {The} {qui} {et} {wa} {ters} {by.} {He} {lead} {eth} {me,} {He} {lead} {eth} {me,} {The} {qui} {et} {wa} {ters} {by,} {In} {pas} {tures} {green} {He} {lead} {eth} {me} {The} {qui} {et} {wa} {ters} {by.}\n