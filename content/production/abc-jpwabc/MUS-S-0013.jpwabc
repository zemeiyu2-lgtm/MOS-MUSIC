// ************** MOS-MUSIC OpenHymnal ABC → JPW-ABC 1.0 **************\n// source = sources/openhymnal/OpenHymnal2014.06.abc\n// match = exact title match from content/production/tune-matching.json\n\n.Title\nTitle = 古旧十架（The Old Rugged Cross）\nKeyAndMeters = {1=Bb,6/4}\nWordsByAndMusicBy = Words: George Bennard, 1913. Music and Setting: 'The Old Rugged Cross' George Bennard, 1913.\ncopyright: public domain.  This score is a part of the Open Hymnal Project, 2010 Revision.\nExpression = {♩=140}\n\n.Voice\n4,_ #4,_ | 5,. #4,_ 6, 5,- 5,_ 5,_ | 6,. #5,_ 7, 6,- 6,_ 6,_ | 7,. 6,_ 5, #4, 5, #4, | 4,.- 4,- 4,_ #4,_ | 5,. #4,_ 6, 5,- 5,_ 5,_ | 6,. #5,_ 7, 6,- 6,_ 6,_ | 7,. 6,_ 5, #4 4 2 | #1.- #1- 7,_ #1_ | 2. 2_ 2 2 #1 7, | #1.- #1- #1_ 7,_ | 6,. 6,_ 6, #1 7, 6, | 5,.- 5,- 5,_ #1_ | 4. 4_ 4 4 #4 4 | 6,.- 6,- #4_ #4_ | 4. 2_ #1 5, 7, 2 | #1.- #1- |\n\n.Words\nW1@1,1:\n{On} a {hill} {far} a {way} {stood} {an} {old} {rug} {ged} {cross,} {The} / {em} {blem} {of} {suff'r} {ing} {and} {shame;} / {And} I {love} {that} {old} {cross} {where} {the} {dear} {est} {and} {best} {For} a {world} {of} {lost} {sin} {ners} {was} {slain.} / {So} {I'll} {cher} {ish} {the} {old} {rug} {ged} {cross,} / {Till} {my} {tro} {phies} {at} {last} I {lay} {down;} / I {will} {cling} {to} {the} {old} {rug} {ged} {cross,} / {And} {ex} {change} {it} {some} {day} {for} a {crown.} /\n