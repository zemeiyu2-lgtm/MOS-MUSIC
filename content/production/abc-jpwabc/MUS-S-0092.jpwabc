// ************** MOS-MUSIC OpenHymnal ABC → JPW-ABC 1.0 **************\n// source = sources/openhymnal/OpenHymnal2014.06.abc\n// match = exact title match from content/production/tune-matching.json\n\n.Title\nTitle = 坚固的根基（How Firm a Foundation）\nKeyAndMeters = {1=Ab,2/2}\nWordsByAndMusicBy = Words: John Rippon, 1787.\nMusic: 'Foundation (Funk)' or 'Protection' Joseph Funk, 1832.  Setting: "Union Harmony", 1837.\ncopyright: public domain.  This score is a part of the Open Hymnal Project, 2007 Revision.\nExpression = {♩=125}\n\n.Voice\n#5, 6, | 2- 6, 2 | #5,- 2 #2 | 4- #2 4 | #5,- #5,- | 2- 6, 2 | #5,- 2 #2 | 4- #2 #2 | 2- 4- | #5- 4 #5 | 2- 2 #2 | 4- #2 4 | #5,- #5,- | 2- 6, 2 | #5,- 2 #2 | 4- #2 #2 | 2- |\n\n.Words\nW1@1,1:\n{How} / {firm} a {foun} {da} {tion,} {ye} {saints} {of} {the} {Lord,} {Is} {laid} {for} {your} {faith} {in} {His} {ex} {cel} {lent} {Word!} {What} {more} {can} {He} {say} {than} {to} {you} {He} {hath} {said,} {You,} {who} {un} {to} {Je} {sus} {for} {re} {fuge} {have} {fled?}\n