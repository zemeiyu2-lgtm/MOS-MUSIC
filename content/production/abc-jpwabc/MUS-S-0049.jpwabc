// ************** MOS-MUSIC OpenHymnal ABC → JPW-ABC 1.0 **************\n// source = sources/openhymnal/OpenHymnal2014.06.abc\n// match = exact title match from content/production/tune-matching.json\n\n.Title\nTitle = 我每时刻需要你（I Need Thee Every Hour）\nKeyAndMeters = {1=Ab,3/4}\nWordsByAndMusicBy = Words: Annie Sherwood Hawks, 1872.\nMusic: 'I Need Thee Every Hour' Robert Lowry, 1872.  Setting: "Pentecostal Hymns, No. 2", 1898.\ncopyright: public domain.  This score is a part of the Open Hymnal Project, 2012 Revision.\nExpression = {♩=80}\n\n.Voice\n2 | 4. #2_ 2_ 7,_ | 2- 2 | 2. #2_ 2_ 6,_ | #5,- #5, | #2. 4_ #2_ #5,_ | 4- 2 | 7,. 2_ 7,_ 6,_ | #5,- | 4 | 4. 2_ 5_ 4_ | 4 #2- | #2. 2_ 4_ #2_ | #2 2 2 | 2. #2_ 2_ 6,_ | #5, 2 #2 | 4. 2_ #2 | 2- |\n\n.Words\nW1@1,1:\nI {need} {Thee} {ev} {'ry} {hour,} {Most} {gra} / {cious_} {Lord;} {No} {ten} {der} {voice} {like} {Thine} {Can} {peace_} {af} / {ford.} I {need} {Thee,} O I {need} {Thee;} {Ev} {'ry} {hour} I {need} {Thee;} O {bless} {me} {now,} {my} {Sav} {ior,} I {come} / {to} {Thee!} / /\n