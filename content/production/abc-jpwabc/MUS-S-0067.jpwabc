// ************** MOS-MUSIC OpenHymnal ABC → JPW-ABC 1.0 **************\n// source = sources/openhymnal/OpenHymnal2014.06.abc\n// match = exact title match from content/production/tune-matching.json\n\n.Title\nTitle = 亲近，更亲近（Nearer, My God, to Thee）\nKeyAndMeters = {1=G,6/4}\nWordsByAndMusicBy = Words: st. 1-2 by Sarah F. Adams, 1841. st. 3-5 by Hervey D. Ganse (1822-1891).\nst. 6 by Edward H. Bickersteth, Jr. (1825-1906).\nMusic: 'Bethany (Mason)' Lowell Mason, 1856.  Setting: Lowell Mason, 1859.\ncopyright: public domain.  This score is a part of the Open Hymnal Project, 2008 Revision.\nExpression = {♩=160}\n\n.Voice\n3.- 2- 1 | 1- 6, 6,.- | 5,.- 1- 3 | 2.- 2- 0 | 3.- 2- 1 | 1- 6, 6,.- | 5,- 1 7,- 2 | 1.- 1- 0 | 5.- 6- 5 | 5- 3 5.- | 5.- 6- 5 | 5- 3 2.- | 3.- 2- 1 | 1- 6, 6,.- | 5,- 1 7,- 2 | 1.- 1- 0 |\n\n.Words\nW1@1,1:\n{Near} {er,} {my} {God,} {to} {Thee,} {near} {er} {to} {Thee!} / {E'en} {though} {it} {be} a {cross} {that} / {rais} {eth} {me,} / {Still} {all} {my} {song} {shall} {be,} {near} {er,} {my} {God,} {to} {Thee.} {Near} {er,} {my} {God,} {to} {Thee,} {Near} / {er} {to} {Thee!} / / / /\n