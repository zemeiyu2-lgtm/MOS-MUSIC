// ************** MOS-MUSIC OpenHymnal ABC → JPW-ABC 1.0 **************\n// source = sources/openhymnal/OpenHymnal2014.06.abc\n// match = exact title match from content/production/tune-matching.json\n\n.Title\nTitle = 荣耀归于真神（To God Be the Glory）\nKeyAndMeters = {1=Ab,3/4}\nWordsByAndMusicBy = Words: Fanny Crosby, 1875. Music and Setting: 'To God Be The Glory' William Howard Doane, 1875.\ncopyright: public domain.  This score is a part of the Open Hymnal Project, 2013 Revision.\nExpression = {♩=120}\n\n.Voice\n#5, | #5,- 6,_ 7,_ | 2 #5, 2 | #2 #5, #2 | 4- 4 | 5 6, 5 | 4 2 4 | 4 #2 6, | #2- #5, | #5,- 6,_ 7,_ | 2 #5, 2 | #2 #5, #2 | 4- 4 | #5 5 #2 | 2 7, 2 | 4 4 #2 | 2- 4._ 5__ | #5- 4._ 5__ | #5- #5._ 4__ | 2 #2 4 | #2- #2._ 4__ | 5- #2._ 4__ | 5- 5_ 2_ | #5 #5 5 | 4- #5, | #5,- 6,_ 7,_ | 2 #5, 2 | #2 #5, #2 | 4- 4 | #5 5 #2 | 2 7, 2 | 4 4 #2 | 2- |\n\n.Words\nW1@1,1:\n{To} {God} {be} {the} {glor} {y,} {great} {things} {He} {has} {done;} {So} {loved} {He} {the} {world} {that} {He} {gave} {us} {His} {Son} {Who} {yield} {ed} {His} {life} {an} a {tone} {ment} {for} {sin,} {And} o {pened} {the} {life} {gate} {that} {all} {may} {go} {in.} {Praise} {the} {Lord,} {praise} {the} {Lord,} {Let} {the} {earth} {hear} {His} {voice!} {Praise} {the} {Lord,} {praise} {the} {Lord,} {Let} {the} {peo} {ple} {re} {joice!} O {come} {to} {the} {Fa} {ther,} {through} {Je} {sus} {the} {Son,} {And} {give} {Him} {the} {glor} {y,} {great} {things} {He} {has} {done.}\n