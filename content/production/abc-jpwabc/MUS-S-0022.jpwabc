// ************** MOS-MUSIC OpenHymnal ABC → JPW-ABC 1.0 **************\n// source = sources/openhymnal/OpenHymnal2014.06.abc\n// match = exact title match from content/production/tune-matching.json\n\n.Title\nTitle = 最美丽耶稣（Fairest Lord Jesus）\nKeyAndMeters = {1=Eb,4/4}\nWordsByAndMusicBy = Words: German Jesuits, published 1677. Translated by Joseph A. Seiss, 1873.\nMusic: 'Crusader`s Hymn' Silesian folk song, 1842.  Setting: Richard S. Willis, 1850.\ncopyright: public domain.  This score is a part of the Open Hymnal Project, 2005 Revision.\nExpression = {♩=120}\n\n.Voice\n#1- #1 #1 | 2 7, #1- | 4- 4 4 | 5 2 4- | #5- #1' 6 | #5- 5 4 | 5- 4- | 2--- | #5- 6 #5 | #5 4 5- | 5- #5 5 | 5 2 4- | 4- 4 4 | #5.- 5 | 4- 2- | #1--- |\n\n.Words\nW1@1,1:\n{Beau} {ti} {ful} {Sa} / {vior,} {King} {of} {Cre} a / {tion} {Son} {of} / {God} {and} / {Son} {of} {Man!} {Tru} {ly} {I'd} {love} / {Thee,} {tru} {ly} {I'd} {serve} / {Thee,} {Light} {of} {my} {soul,} {my} {joy,} {my} {crown.}\n