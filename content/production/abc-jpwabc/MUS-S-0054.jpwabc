// ************** MOS-MUSIC OpenHymnal ABC → JPW-ABC 1.0 **************\n// source = sources/openhymnal/OpenHymnal2014.06.abc\n// match = exact title match from content/production/tune-matching.json\n\n.Title\nTitle = 万古磐石（Rock of Ages）\nKeyAndMeters = {1=Bb,6/4}\nWordsByAndMusicBy = Words: Augustus Montague Toplady, 1776.  Music: 'Toplady' Thomas Hastings, 1830.\nSetting: "Congregational Church Music with 150 Psalms and Hymns", 1854.\ncopyright: public domain.  This score is a part of the Open Hymnal Project, 2010 Revision.\nExpression = {♩=170}\n\n.Voice\n5,. 6,_ | 5,- 4,- #1. 6,_ | 5,--- #1. 2_ | 4.- 2 #1 7, | #1--- 7,. #1_ | 2.- 2 7, 5, | #1--- 7,. #1_ | 2.- 2 7, 5, | #1--- 5,. 6,_ | 5,- 4,- #1. 6,_ | 5,--- #1. 2_ | 4.- 2 #1 7, | #1--- |\n\n.Words\nW1@1,1:\n{Rock} {of} A {ges,} {cleft} {for} {me,} {Let} {me} {hide} {my} {self} {in} {Thee;} {Let} {the} {wa} {ter} {and} {the} {blood,} {From} {Thy} {wound} {ed} {side} {which} {flowed,} {Be} {of} {sin} {the} {doub} {le} {cure;} {Save} {from} {wrath} {and} {make} {me} {pure.}\n