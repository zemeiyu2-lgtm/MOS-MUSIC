// ************** MOS-MUSIC OpenHymnal ABC → JPW-ABC 1.0 **************\n// source = sources/openhymnal/OpenHymnal2014.06.abc\n// match = exact title match from content/production/tune-matching.json\n\n.Title\nTitle = 我主，我神，我王（All Hail the Power of Jesus' Name）\nKeyAndMeters = {1=G,4/4}\nWordsByAndMusicBy = Words: Edward Perronet, 1780.  Music: 'Coronation' Oliver Holden, 1793.\nSetting: "The Church Hymnal, Revised and Enlarged" (Episcopal), 1896, alt.\ncopyright: public domain.  This score is a part of the Open Hymnal Project, 2007 Revision.\nExpression = {♩=120}\n\n.Voice\n5, | 1 1 3 3 | 2 1 2 3 | 2 1 3 2 | 1.- 2 | 3 2 1 3 | 5_ 4_ 3_ 2_ 3 5 | 5- 5- | 6- 5 #4 | 5.- 3 | 5 3 1 3 | 2_ 1_ 2_ 3_ 2 1 | 5- 4- | 3. 4_ 2 2 | 1.- |\n\n.Words\nW1@1,1:\n{All} {hail} {the} {pow'r} {of} {Je} {sus'} {Name!} {Let} {an} {gels} {pros} {trate} {fall;} {Bring} {forth} {the} {ro} {yal} {di} / a / {dem,} {and} {crown} {Him} {Lord} {of} / {all.} {Bring} {forth} {the} {ro} {yal} {di} / a / {dem,} {and} {crown} {Him} {Lord} / / {of} {all.}\n