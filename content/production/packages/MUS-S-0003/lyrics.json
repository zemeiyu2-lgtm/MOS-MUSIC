  "sections": [
    {
      "section_id": "v1",
      "label": "Verse 1",
      "lines": [
        { "line_id": "v1-L1", "lyric_id": "MUS-S-0003-L01", "phrase_id": null, "text": "Jesus calls us o'er the tumult" },
        { "line_id": "v1-L2", "lyric_id": "MUS-S-0003-L02", "phrase_id": null, "text": "Of our life's wild, restless sea;" },
        { "line_id": "v1-L3", "lyric_id": "MUS-S-0003-L03", "phrase_id": null, "text": "Day by day His sweet voice soundeth," },
        { "line_id": "v1-L4", "lyric_id": "MUS-S-0003-L04", "phrase_id": null, "text": "Saying, \"Christian, follow Me.\"" }
      ]
    },
    {
      "section_id": "v2",
      "label": "Verse 2",
      "lines": [
        { "line_id": "v2-L1", "lyric_id": "MUS-S-0003-L05", "phrase_id": null, "text": "Jesus calls us from the worship" },
        { "line_id": "v2-L2", "lyric_id": "MUS-S-0003-L06", "phrase_id": null, "text": "Of the vain world's golden store," },
        { "line_id": "v2-L3", "lyric_id": "MUS-S-0003-L07", "phrase_id": null, "text": "From each idol that would keep us," },
        { "line_id": "v2-L4", "lyric_id": "MUS-S-0003-L08", "phrase_id": null, "text": "Saying, \"Christian, love Me more.\"" }
      ]
    },
    {
      "section_id": "v3",
      "label": "Verse 3",
      "lines": [
        { "line_id": "v3-L1", "lyric_id": "MUS-S-0003-L09", "phrase_id": null, "text": "In our joys and in our sorrows," },
        { "line_id": "v3-L2", "lyric_id": "MUS-S-0003-L10", "phrase_id": null, "text": "Days of toil and hours of ease," },
        { "line_id": "v3-L3", "lyric_id": "MUS-S-0003-L11", "phrase_id": null, "text": "Still He calls, in cares and pleasures," },
        { "line_id": "v3-L4", "lyric_id": "MUS-S-0003-L12", "phrase_id": null, "text": "\"Christian, love Me more than these.\"" }
      ]
    },
    {
      "section_id": "v4",
      "label": "Verse 4",
      "lines": [
        { "line_id": "v4-L1", "lyric_id": "MUS-S-0003-L13", "phrase_id": null, "text": "Jesus calls us! By Thy mercies," },
        { "line_id": "v4-L2", "lyric_id": "MUS-S-0003-L14", "phrase_id": null, "text": "Saviour, may we hear Thy call," },
        { "line_id": "v4-L3", "lyric_id": "MUS-S-0003-L15", "phrase_id": null, "text": "Give our hearts to Thy obedience," },
        { "line_id": "v4-L4", "lyric_id": "MUS-S-0003-L16", "phrase_id": null, "text": "Serve and love Thee best of all." }
      ]
    }
  ],
  "note": "中文译本：NOT_AVAILABLE（权利未确认）。需要中文时由人工提供已获授权文本或完成授权后再录入。"
