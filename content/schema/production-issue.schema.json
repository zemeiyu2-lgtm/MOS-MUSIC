{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mos-music.local/schema/production-issue.schema.json",
  "title": "MOS-MUSIC Calibration Issue",
  "description": "校准问题记录（§十二）。平台只记录、分类、累积，不因发现问题而自动修改已冻结的技能。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issue_id", "date", "week", "song", "category", "description", "evidence",
    "current_behavior", "expected_behavior", "severity", "workaround",
    "proposed_change", "status", "target_version"
  ],
  "properties": {
    "issue_id": { "type": "string", "pattern": "^CI-[0-9]{4}$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "week": { "type": ["string", "null"], "maxLength": 12 },
    "song": { "type": ["string", "null"], "maxLength": 24 },
    "category": {
      "type": "string",
      "enum": [
        "unit_level_gate", "cross_week_reuse", "baseline_scope", "song_relation",
        "theological_risk", "practice_conversion", "transmission_conversion",
        "library_capacity", "evidence_sufficiency", "two_layer_verdict", "process"
      ]
    },
    "description": { "type": "string", "minLength": 20, "maxLength": 600 },
    "evidence": { "type": "string", "minLength": 10, "maxLength": 600 },
    "current_behavior": { "type": "string", "minLength": 10, "maxLength": 400 },
    "expected_behavior": { "type": "string", "minLength": 10, "maxLength": 400 },
    "severity": { "type": "string", "enum": ["BLOCKER", "HIGH", "MEDIUM", "LOW", "INFO"] },
    "workaround": { "type": ["string", "null"], "maxLength": 400 },
    "proposed_change": { "type": "string", "minLength": 10, "maxLength": 600 },
    "status": {
      "type": "string",
      "enum": ["OPEN", "OBSERVED", "REVIEWED", "ACCEPTED", "REJECTED", "FIXED", "DEFERRED"]
    },
    "target_version": { "type": ["string", "null"], "maxLength": 40 },
    "resolution_layer": { "type": "string", "enum": ["platform", "skill", "content", "process"] },
    "resolved_note": { "type": ["string", "null"], "maxLength": 400 }
  }
}
