{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mos-music.local/schema/annual-week.schema.json",
  "title": "MOS-MUSIC Annual Week Sample",
  "description": "年度样本周（如 2027-W01）。形成链：52W → 年度音乐映射 → MM 主题 → 歌曲 → 七步法 → 生命实践。52W 数据一律引用，不复制。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "annual_id", "year", "week_id", "mos_week", "bible_passage_id",
    "core_truth", "life_question_id", "music_unit_id", "music_function",
    "core_song_id", "auxiliary_song_id", "seven_step_practice",
    "life_practice", "transmission_task", "status"
  ],
  "properties": {
    "annual_id": { "type": "string", "pattern": "^MOS-MUSIC-ANNUAL-[0-9]{4}$" },
    "year": { "type": "integer" },
    "week_id": { "$ref": "common.schema.json#/$defs/annualWeekId" },
    "mos_week": { "$ref": "common.schema.json#/$defs/mosWeekId" },
    "sermon_week_ref": {
      "type": ["string", "null"],
      "maxLength": 120,
      "description": "指向 2027 讲道释经正式来源的周记录（只读引用）。"
    },
    "bible_passage_id": { "$ref": "common.schema.json#/$defs/passageRef" },
    "bible_reference_ids": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/bibleRefId" }
    },
    "core_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "provenance"],
      "description": "经文中心。取自 MOS 2027 正式来源，provenance.copy_policy=reference_only。",
      "properties": {
        "text": { "type": "string", "minLength": 10, "maxLength": 300 },
        "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
      }
    },
    "life_question_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/lqId" },
        { "type": "null" }
      ]
    },
    "music_unit_id": {
      "type": "array",
      "minItems": 0,
      "maxItems": 2,
      "items": { "$ref": "common.schema.json#/$defs/musicUnitId" },
      "description": "0–2 个 MM 单元。选择依据是经文真理→神学→门训主题，不得反向凑配。"
    },
    "mm_rationale": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "description": "为什么这周的圣经真理适合通过这个（这些）音乐主题进行门徒形成。必填。"
    },
    "music_function": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "$ref": "common.schema.json#/$defs/musicFunction" }
    },
    "core_song_id": {
      "oneOf": [
        { "$ref": "common.schema.json#/$defs/songId" },
        { "type": "null" }
      ]
    },
    "auxiliary_song_id": {
      "type": "array",
      "maxItems": 2,
      "items": { "$ref": "common.schema.json#/$defs/songId" }
    },
    "seven_step_practice": { "$ref": "common.schema.json#/$defs/sevenSteps" },
    "life_practice": { "type": "string", "minLength": 15, "maxLength": 300 },
    "transmission_task": { "type": "string", "minLength": 15, "maxLength": 300 },
    "expected_formation": { "type": ["string", "null"], "maxLength": 300 },
    "status": {
      "type": "string",
      "enum": ["sample", "reviewed", "approved", "published"]
    },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" }
  }
}
