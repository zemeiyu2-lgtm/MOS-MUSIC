{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mos-music.local/schema/music-unit.schema.json",
  "title": "MOS-MUSIC Music Unit (Framework Mother Library)",
  "description": "Phase 2A 裁决：MM01–MM24 正式定义为 Framework 层的 Music Unit / Music Theme Mother Library——稳定主题词汇、音乐门训分类体系、年度计划的可调用主题。禁止解释为「24 周年度音乐计划」，本文件不得出现任何年度周次引用。",
  "type": "object",
  "additionalProperties": false,
  "required": ["library_version", "decision_ref", "units"],
  "properties": {
    "library_version": { "$ref": "common.schema.json#/$defs/version" },
    "layer": { "type": "string", "const": "framework" },
    "decision_ref": { "type": "string", "minLength": 10, "maxLength": 400 },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["not_annual_plan", "no_week_references"],
      "properties": {
        "not_annual_plan": { "type": "boolean", "const": true },
        "no_week_references": { "type": "boolean", "const": true },
        "note": { "type": "string", "maxLength": 300 }
      }
    },
    "units": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unit_id", "no", "title", "group", "definition", "formation_direction", "function_affinity"],
        "properties": {
          "unit_id": { "$ref": "common.schema.json#/$defs/musicUnitId" },
          "no": { "type": "integer", "minimum": 1, "maximum": 24 },
          "title": { "type": "string", "minLength": 2, "maxLength": 20 },
          "group": { "type": "string", "enum": ["认识神", "认识基督", "新生命", "共同体", "生活", "使命与传递"] },
          "definition": { "type": "string", "minLength": 10, "maxLength": 200 },
          "formation_direction": { "type": "string", "minLength": 10, "maxLength": 200 },
          "function_affinity": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": { "$ref": "common.schema.json#/$defs/musicFunction" }
          },
          "map_projection": {
            "type": ["string", "null"],
            "maxLength": 40,
            "description": "同序既有结构引用（如 MUS-C-NN / MAP-CNN），说明母库与 Phase 1 映射表的关系。只存引用。"
          }
        }
      }
    }
  }
}
